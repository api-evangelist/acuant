          "name": "Evaluate image for liveness",
          "request": {
            "name": "Evaluate image for liveness",
            "description": {
              "content": "Submits a selfie image for passive liveness detection. The API analyzes the image for presentation attack indicators and returns an assessment of whether a live person is depicted. Detects printed photos, masks, screen replays, deepfakes, and face-swap attacks.",
              "type": "text/plain"
            },
