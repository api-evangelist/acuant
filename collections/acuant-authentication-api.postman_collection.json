      "item": [
        {
          "id": "fbe9fb6c-900b-43bc-bc8b-97d885bfbf6c",
          "name": "Obtain bearer token",
          "request": {
            "name": "Obtain bearer token",
            "description": {
              "content": "Exchanges Basic Auth credentials (Base64-encoded username:password) for a bearer token. The returned token is used to authenticate requests to other Acuant APIs (FRM, Passive Liveness, etc.). Tokens are time-limited and should be refreshed before expiry.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "f9ab05c2-699c-47c7-9866-813253a6fe20",
              "name": "Bearer token issued successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v1",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": \"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"tokenKey\": \"Bearer\",\n  \"tokenType\": \"JWT\",\n  \"expiresIn\": 1800\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
