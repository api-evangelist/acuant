          "id": "c469cc55-cde7-423b-b8b5-f33e667ac500",
          "name": "Validate bearer token",
          "request": {
            "name": "Validate bearer token",
            "description": {
              "content": "Checks whether a bearer token is still valid and not expired.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "token",
                "validate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
